#, python-format
msgctxt "model:ir.message,text:msg_contact_name"
msgid "Contact name in report \"%(name)s\" must contain name and surname"
msgstr ""
"ឈ្មោះអ្នកទំនាក់ទំនងក្នុងរបាយការណ៍ «%(name)s» ត្រូវមាននាមខ្លួន និងនាមត្រកូល"

#, python-format
msgctxt "model:ir.message,text:msg_delete_lines_in_349report"
msgid ""
"There are some invoices lines from invoices\n"
"%(invoices)s\n"
"that will be erased in 349 repotrs.\n"
"To do that the reports\n"
"%(reports)s\n"
"must be canceleld or drafted."
msgstr ""
"បន្ទាត់នៃវិក្កយបត្រ\n"
"%(invoices)s\n"
"នឹងត្រូវបានលុបពីរបាយការណ៍ 349។\n"
"ដើម្បីធ្វើដូច្នេះ របាយការណ៍\n"
"%(reports)s\n"
"ត្រូវបានបោះបង់ ឬកំណត់ជាសេចក្តីព្រាងជាមុន។"

#, python-format
msgctxt "model:ir.message,text:msg_delete_moves_in_349report"
msgid ""
"There are some moves from shipments\n"
"%(shipments)s\n"
"that will be erased in 349 repotrs.\n"
"To do that the reports\n"
"%(reports)s\n"
"must be canceleld or drafted."
msgstr ""
"ចលនាស្តុកនៃការដឹកជញ្ជូន\n"
"%(shipments)s\n"
"នឹងត្រូវបានលុបពីរបាយការណ៍ 349។\n"
"ដើម្បីធ្វើដូច្នេះ របាយការណ៍\n"
"%(reports)s\n"
"ត្រូវបានបោះបង់ ឬកំណត់ជាសេចក្តីព្រាងជាមុន។"

#, python-format
msgctxt "model:ir.message,text:msg_forbiden_cancel"
msgid ""
"Not possible to cancel the invoice %(invoice)s becasue it's on AEAT349 report"
" %(report)s."
msgstr ""
"មិនអាចបោះបង់វិក្កយបត្រ %(invoice)s បានទេ ព្រោះវាមានក្នុងរបាយការណ៍ AEAT349 "
"%(report)s។"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_currency"
msgid "Currency in AEAT 349 report \"%(name)s\" must be Euro."
msgstr "រូបិយប័ណ្ណនៃរបាយការណ៍ AEAT 349 «%(name)s» ត្រូវតែជាអឺរ៉ូ។"

