#, python-format
msgctxt "model:ir.message,text:msg_contact_name"
msgid "Contact name in report \"%(name)s\" must contain name and surname"
msgstr ""
"A(z) „%(name)s” bevallásban a kapcsolattartó nevének utónevet és "
"vezetéknevet is kell tartalmaznia"

#, python-format
msgctxt "model:ir.message,text:msg_delete_lines_in_349report"
msgid ""
"There are some invoices lines from invoices\n"
"%(invoices)s\n"
"that will be erased in 349 repotrs.\n"
"To do that the reports\n"
"%(reports)s\n"
"must be canceleld or drafted."
msgstr ""
"A következő számlák egyes sorai\n"
"%(invoices)s\n"
"törlődnek a 349-es bevallásokból.\n"
"Ehhez a következő bevallásokat\n"
"%(reports)s\n"
"vissza kell vonni vagy tervezett állapotba kell állítani."

#, python-format
msgctxt "model:ir.message,text:msg_delete_moves_in_349report"
msgid ""
"There are some moves from shipments\n"
"%(shipments)s\n"
"that will be erased in 349 repotrs.\n"
"To do that the reports\n"
"%(reports)s\n"
"must be canceleld or drafted."
msgstr ""
"A következő szállítmányok egyes készletmozgásai\n"
"%(shipments)s\n"
"törlődnek a 349-es bevallásokból.\n"
"Ehhez a következő bevallásokat\n"
"%(reports)s\n"
"vissza kell vonni vagy tervezett állapotba kell állítani."

#, python-format
msgctxt "model:ir.message,text:msg_forbiden_cancel"
msgid ""
"Not possible to cancel the invoice %(invoice)s becasue it's on AEAT349 "
"report %(report)s."
msgstr ""
"A(z) %(invoice)s számla nem vonható vissza, mert szerepel a(z) %(report)s "
"AEAT349 bevallásban."

#, python-format
msgctxt "model:ir.message,text:msg_invalid_currency"
msgid "Currency in AEAT 349 report \"%(name)s\" must be Euro."
msgstr "A(z) „%(name)s” AEAT 349 bevallás pénznemének eurónak kell lennie."

#, python-format
msgctxt "model:ir.message,text:msg_invalid_year"
msgid "The year \"%(year)s\" is not valid."
msgstr "A(z) „%(year)s” év érvénytelen."

